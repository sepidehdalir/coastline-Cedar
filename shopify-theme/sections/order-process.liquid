<section class="section order-process">
  <div class="container">
    <div class="reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="order-process__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <ol class="order-process__steps" aria-label="How to order">
      {%- for block in section.blocks -%}
        <li class="step-card reveal reveal--delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="step-card__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- if block.settings.title != blank -%}
            <h3 class="step-card__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="step-card__body">{{ block.settings.description }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

<style>
.order-process__heading { margin-top: 0.75rem; max-width: 36rem; }
.order-process__steps {
  display: grid;
  gap: 1.25rem;
  margin-top: 3rem;
  list-style: none;
  padding: 0;
}
@media (min-width: 768px) { .order-process__steps { grid-template-columns: repeat(3, 1fr); } }
</style>

{% schema %}
{
  "name": "Order process",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How ordering works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three simple steps to a finished planter." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Step title", "default": "Choose your size" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Choose from our standard sizes — or request custom dimensions." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Order process",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose your size", "description": "Choose from our standard sizes — or request custom dimensions." } },
        { "type": "step", "settings": { "title": "Place your order", "description": "Order online or send a quote request. We confirm details within one business day." } },
        { "type": "step", "settings": { "title": "Pickup or delivery", "description": "Pickup by appointment in North Vancouver, or delivery across Metro Vancouver." } }
      ]
    }
  ]
}
{% endschema %}
