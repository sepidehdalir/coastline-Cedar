<div class="section">
  <div class="container" style="max-width: 28rem;">
    <h1>{{ 'customer.login.title' | t }}</h1>
    {%- form 'customer_login', id: 'CustomerLoginForm' -%}
      {%- if form.errors -%}
        <div class="form-error-box" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-field" style="margin-top: 1.5rem;">
        <label class="form-label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" class="form-input" required>
      </div>
      <div class="form-field" style="margin-top: 1rem;">
        <label class="form-label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" class="form-input" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full" style="margin-top: 1.5rem;">{{ 'customer.login.submit' | t }}</button>
      <p style="margin-top: 1rem; text-align: center; font-size: var(--text-sm);">
        <a href="{{ routes.root_url }}account/register" class="text-accent">{{ 'customer.login.create_account' | t }}</a>
      </p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Login",
  "settings": []
}
{% endschema %}
