<section class="section rich-text section--{{ section.settings.background }}">
  <div class="container">
    <div class="rich-text__inner" style="max-width: {{ section.settings.max_width | default: 56 }}rem; margin-inline: auto; text-align: {{ section.settings.text_align | default: 'left' }};">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="rich-text__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <div class="rich-text__cta">
          <a href="{{ section.settings.button_url }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.rich-text__heading { margin-top: 0.75rem; }
.rich-text__body {
  margin-top: 1.25rem;
  color: var(--color-text-muted);
  line-height: 1.75;
}
.rich-text__body p + p { margin-top: 1rem; }
.rich-text__body a { color: var(--color-cedar-700); }
.rich-text__body a:hover { text-decoration: underline; }
.rich-text__cta { margin-top: 2rem; }
</style>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "bone",  "label": "Bone" }
      ],
      "default": "cream"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width (rem)",
      "min": 36,
      "max": 80,
      "step": 2,
      "default": 56
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
