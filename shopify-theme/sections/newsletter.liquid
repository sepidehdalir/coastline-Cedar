{%- if section.settings.show_section -%}
<section class="section newsletter-section">
  <div class="container">
    <div class="newsletter-section__inner reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" style="text-align:center;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="newsletter-section__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-success-box" role="alert" style="text-align:center;">{{ section.settings.success_message | default: 'Thanks — you are subscribed.' }}</p>
        {%- else -%}
          <div class="newsletter-form" aria-label="Newsletter signup">
            <label for="NewsletterEmail" class="visually-hidden">{{ section.settings.placeholder | default: 'Your email address' }}</label>
            <input
              type="email"
              id="NewsletterEmail"
              name="contact[email]"
              class="form-input"
              placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
              required
              autocomplete="email"
              aria-required="true"
            >
            <button type="submit" class="btn btn--primary">
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="form-error-box" role="alert" style="margin-top:0.75rem;">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="newsletter-section__disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

<style>
.newsletter-section__heading {
  font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
  margin-top: 0.75rem;
  margin-bottom: 0.75rem;
}
.newsletter-section__subtext { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: var(--text-sm); }
.newsletter-section__disclaimer {
  margin-top: 0.875rem;
  font-size: 0.75rem;
  color: var(--color-text-faint);
}
</style>

{% schema %}
{
  "name": "Newsletter",
  "limit": 1,
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show newsletter section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New builds, cedar tips, and local delivery updates." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "We send occasional notes about new planter sizes, seasonal promotions, and project inspiration from our North Vancouver workshop." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — you are subscribed." },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "No spam. Unsubscribe any time." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
