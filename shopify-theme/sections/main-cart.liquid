<div class="section">
  <div class="container" style="max-width: 56rem;">
    <h1>{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      {%- assign cc_free_delivery_threshold = 20000 -%}
      {%- assign cc_amount_to_free_delivery = cc_free_delivery_threshold | minus: cart.total_price -%}
      <div class="cc-cart-delivery" aria-live="polite">
        {%- if cart.total_price >= cc_free_delivery_threshold -%}
          <p class="cc-cart-delivery__title">✓ You qualify for FREE local delivery</p>
          <p class="cc-cart-delivery__sub">On eligible Greater Vancouver orders. Free pickup in North Vancouver is also available.</p>
        {%- else -%}
          <p class="cc-cart-delivery__title">Add {{ cc_amount_to_free_delivery | money }} more for FREE local delivery</p>
          <p class="cc-cart-delivery__sub">On eligible Greater Vancouver orders. Orders under $200: CAD $25 local delivery.</p>
        {%- endif -%}
      </div>
      {%- form 'cart', cart, id: 'CartForm' -%}
        <div class="cart-items" style="margin-top: 2rem;">
          {%- for item in cart.items -%}
            <div class="cart-item">
              <div class="cart-item__image">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="80" height="80" style="border-radius: var(--radius-md); object-fit: cover;">
                {%- endif -%}
              </div>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item__price">{{ item.final_price | money }}</p>
              </div>
              <div class="cart-item__qty">
                <label class="visually-hidden" for="Quantity-{{ item.index }}">Quantity</label>
                <input
                  type="number"
                  id="Quantity-{{ item.index }}"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  class="form-input"
                  style="width: 4rem; text-align: center;"
                >
              </div>
              <a href="{{ item.url_to_remove }}" class="cart-item__remove" aria-label="{{ 'cart.remove' | t: default: 'Remove' }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </a>
            </div>
          {%- endfor -%}
        </div>

        <div class="cc-cart-trust" role="list" aria-label="Order assurances">
          <span role="listitem">Fully assembled</span>
          <span role="listitem">Made to order</span>
          <span role="listitem">3–5 business days</span>
          <span role="listitem">3-year workmanship warranty</span>
        </div>

        <div class="cart-footer">
          <p class="cart-footer__total">Total: <strong>{{ cart.total_price | money }}</strong></p>
          <div class="cart-footer__actions">
            <button type="submit" name="update" class="btn btn--secondary">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary btn--lg">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      {%- endform -%}

    {%- else -%}
      <div class="empty-state" style="margin-top: 2rem;">
        <p class="empty-state__title">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.collections_url }}" class="btn btn--primary">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
.cart-items { display: flex; flex-direction: column; gap: 1rem; }

.cart-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: #fff;
}

.cart-item__image { flex-shrink: 0; }
.cart-item__details { flex: 1; }
.cart-item__title { font-weight: var(--font-semibold); color: var(--color-text); text-decoration: none; }
.cart-item__title:hover { color: var(--color-cedar-700); }
.cart-item__variant { font-size: var(--text-sm); color: var(--color-text-muted); }
.cart-item__price { font-size: var(--text-sm); margin-top: 0.25rem; }
.cart-item__remove { color: var(--color-text-faint); flex-shrink: 0; }
.cart-item__remove:hover { color: var(--color-text); }

.cart-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}

.cart-footer__total { font-size: var(--text-lg); }
.cart-footer__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.cc-cart-delivery {
  margin-top: 1rem;
  padding: 1rem 1.125rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: var(--color-bone);
}
.cc-cart-delivery__title {
  margin: 0;
  font-weight: var(--font-semibold);
  color: var(--color-forest-600);
}
.cc-cart-delivery__sub {
  margin-top: 0.25rem;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}
.cc-cart-trust {
  margin-top: 1.5rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.cc-cart-trust span {
  padding: 0.4rem 0.7rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  background: var(--color-bone);
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}
@media (max-width: 639px) {
  .cart-item {
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem;
  }
  .cart-item__image img {
    width: 64px !important;
    height: 64px !important;
    object-fit: contain !important;
    background: var(--color-bone);
  }
  .cart-item__qty input {
    width: 3.5rem !important;
  }
  .cart-footer {
    align-items: stretch;
    justify-content: stretch;
    gap: 1rem;
  }
  .cart-footer__total {
    width: 100%;
    display: flex;
    justify-content: space-between;
  }
  .cart-footer__actions {
    width: 100%;
    flex-direction: column-reverse;
  }
  .cart-footer__actions .btn {
    width: 100%;
    min-height: 3.25rem;
  }
}
</style>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
