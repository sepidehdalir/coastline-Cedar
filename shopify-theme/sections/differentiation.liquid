<section class="differentiation section--{{ section.settings.background }}">
  <div class="container">

    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="differentiation__heading reveal reveal--delay-1">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="differentiation__intro reveal reveal--delay-2">{{ section.settings.intro }}</p>
    {%- endif -%}

    <div class="differentiation__grid reveal reveal--delay-3">

      <div class="differentiation__col differentiation__col--us">
        <div class="differentiation__col-header">
          <span class="differentiation__col-label differentiation__col-label--us">{{ section.settings.col_us_label | default: 'Coastline Cedar' }}</span>
        </div>
        <ul class="differentiation__list" role="list">
          {%- for i in (1..8) -%}
            {%- assign key = 'us_' | append: i -%}
            {%- if section.settings[key] != blank -%}
              <li class="differentiation__item differentiation__item--us">
                <svg class="differentiation__icon differentiation__icon--check" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="8" fill="var(--color-forest-500)" opacity="0.12"/>
                  <path d="M4.5 8.25L6.75 10.5L11.5 5.5" stroke="var(--color-forest-600)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {{ section.settings[key] }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="differentiation__col differentiation__col--them">
        <div class="differentiation__col-header">
          <span class="differentiation__col-label differentiation__col-label--them">{{ section.settings.col_them_label | default: 'Mass-Market Alternatives' }}</span>
        </div>
        <ul class="differentiation__list" role="list">
          {%- for i in (1..8) -%}
            {%- assign key = 'them_' | append: i -%}
            {%- if section.settings[key] != blank -%}
              <li class="differentiation__item differentiation__item--them">
                <svg class="differentiation__icon differentiation__icon--x" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="8" fill="var(--color-text-faint)" opacity="0.15"/>
                  <path d="M5.5 5.5L10.5 10.5M10.5 5.5L5.5 10.5" stroke="var(--color-text-muted)" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                {{ section.settings[key] }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="differentiation__footnote reveal">{{ section.settings.footnote }}</p>
    {%- endif -%}

  </div>
</section>

<style>
.differentiation { padding-block: var(--section-gap); }

.differentiation__heading {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: var(--font-semibold);
  letter-spacing: -0.02em;
  color: var(--color-text);
  margin-top: 0.5rem;
  max-width: 36rem;
}

.differentiation__intro {
  margin-top: 1rem;
  max-width: 42rem;
  color: var(--color-text-muted);
  line-height: 1.65;
}

.differentiation__grid {
  display: grid;
  gap: 1.5rem;
  margin-top: 2.5rem;
}

@media (min-width: 768px) {
  .differentiation__grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
}

.differentiation__col {
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.differentiation__col--us {
  border: 1.5px solid var(--color-forest-500);
  background-color: var(--color-cream);
}

.differentiation__col--them {
  border: 1.5px solid var(--color-border);
  background-color: var(--color-bone);
}

.differentiation__col-header {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--color-border);
}

.differentiation__col--us .differentiation__col-header {
  background-color: var(--color-forest-500);
  border-bottom-color: var(--color-forest-600);
}

.differentiation__col-label {
  font-size: var(--text-sm);
  font-weight: var(--font-semibold);
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.differentiation__col-label--us { color: var(--color-cream); }
.differentiation__col-label--them { color: var(--color-text-muted); }

.differentiation__list {
  list-style: none;
  padding: 1.25rem 1.5rem;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}

.differentiation__item {
  display: flex;
  align-items: flex-start;
  gap: 0.625rem;
  font-size: var(--text-sm);
  line-height: 1.5;
  color: var(--color-text);
}

.differentiation__item--them { color: var(--color-text-muted); }

.differentiation__icon { flex-shrink: 0; margin-top: 0.125rem; }

.differentiation__footnote {
  margin-top: 2rem;
  font-size: var(--text-xs);
  color: var(--color-text-faint);
  max-width: 42rem;
}
</style>

{% schema %}
{
  "name": "Differentiation",
  "limit": 1,
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "options": [{"value":"cream","label":"Cream"},{"value":"bone","label":"Bone"},{"value":"white","label":"White"}], "default": "cream" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What sets us apart" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built Differently—Because It Is" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Every Coastline Cedar planter is handcrafted individually in North Vancouver and delivered fully assembled. Here's how that differs from what you'll find at most retailers." },
    { "type": "header", "content": "Coastline Cedar column" },
    { "type": "text", "id": "col_us_label", "label": "Column label", "default": "Coastline Cedar" },
    { "type": "text", "id": "us_1", "label": "Point 1", "default": "Handcrafted individually in North Vancouver" },
    { "type": "text", "id": "us_2", "label": "Point 2", "default": "Delivered fully assembled — ready to plant" },
    { "type": "text", "id": "us_3", "label": "Point 3", "default": "Premium Western Cedar, not composite or generic lumber" },
    { "type": "text", "id": "us_4", "label": "Point 4", "default": "Made to order — not pulled from warehouse inventory" },
    { "type": "text", "id": "us_5", "label": "Point 5", "default": "Custom sizing available for any space" },
    { "type": "text", "id": "us_6", "label": "Point 6", "default": "Direct support from the local builder" },
    { "type": "text", "id": "us_7", "label": "Point 7", "default": "Natural cedar character — no two pieces are identical" },
    { "type": "text", "id": "us_8", "label": "Point 8", "default": "Stainless steel hardware throughout" },
    { "type": "header", "content": "Comparison column" },
    { "type": "text", "id": "col_them_label", "label": "Column label", "default": "Mass-Market Alternatives" },
    { "type": "text", "id": "them_1", "label": "Point 1", "default": "Factory-produced in large batches" },
    { "type": "text", "id": "them_2", "label": "Point 2", "default": "Delivered flat-packed — customer assembly required" },
    { "type": "text", "id": "them_3", "label": "Point 3", "default": "Generic or composite materials, often unspecified" },
    { "type": "text", "id": "them_4", "label": "Point 4", "default": "Pre-manufactured from existing stock" },
    { "type": "text", "id": "them_5", "label": "Point 5", "default": "Fixed standard sizes only" },
    { "type": "text", "id": "them_6", "label": "Point 6", "default": "Marketplace or call-centre support" },
    { "type": "text", "id": "them_7", "label": "Point 7", "default": "Uniform, manufactured appearance" },
    { "type": "text", "id": "them_8", "label": "Point 8", "default": "Hardware quality varies" },
    { "type": "header", "content": "Footnote" },
    { "type": "textarea", "id": "footnote", "label": "Footnote (optional)", "default": "Comparisons reflect general product-category characteristics and are not directed at any specific retailer or brand." }
  ],
  "presets": [{ "name": "Differentiation" }]
}
{% endschema %}
