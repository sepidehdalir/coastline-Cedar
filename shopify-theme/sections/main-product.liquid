{%- liquid
  comment
    is_quote_only: only when custom.quote_only metafield is explicitly "true".
    Never inferred from product.price, inventory, type, title, or collection.
  endcomment
  assign is_quote_only = false
  if product.metafields.custom.quote_only == 'true'
    assign is_quote_only = true
  endif

  comment
    Price display: find the lowest variant price that is greater than zero.
    Products may have a "Natural (unfinished)" variant at $0 that must not be used
    as the displayed starting price. Loop variants; take the first priced > 0.
    Fall back to product.price only when every variant costs $0.
  endcomment
  assign display_price   = 0
  assign display_compare = 0
  for variant in product.variants
    if variant.price > 0 and display_price == 0
      assign display_price   = variant.price
      assign display_compare = variant.compare_at_price
    endif
  endfor
  if display_price == 0
    assign display_price   = product.price
    assign display_compare = product.compare_at_price
  endif

  assign is_on_sale = false
  if display_compare > display_price
    assign is_on_sale = true
  endif

  comment
    Canada shipping-by-quote positioning is limited to the two eligible products.
    Every other planter keeps Metro Vancouver pickup/delivery positioning.
  endcomment
  assign na_handles = 'classic-cedar-patio-planter,long-cedar-balcony-planter' | split: ','
  assign ships_na = false
  if na_handles contains product.handle
    assign ships_na = true
  endif

  comment
    Only render the "Preferred stain colour" property field for products that
    genuinely offer a CUSTOM STAIN finish. Products without it (Elevated Cedar
    Garden Bed, Classic 48, etc.) must not render the field, the line-item
    property, the required marker, or its explanatory text at all — not merely
    hide it with CSS.
  endcomment
  assign is_best_seller = false
  if product.handle == 'raised-cedar-garden-planter'
    assign is_best_seller = true
  endif

  assign has_custom_stain = false
  for stain_variant in product.variants
    assign stain_opts = stain_variant.options | join: ' ' | downcase
    if stain_opts contains 'custom' and stain_opts contains 'stain'
      assign has_custom_stain = true
      break
    endif
  endfor
-%}

<!-- Breadcrumb -->
<nav class="breadcrumb container" aria-label="Breadcrumb">
  <ol class="breadcrumb__list" role="list">
    <li><a href="{{ routes.root_url }}">Home</a></li>
    <li aria-hidden="true">/</li>
    <li><a href="{{ routes.collections_url }}">Shop</a></li>
    <li aria-hidden="true">/</li>
    <li aria-current="page">{{ product.title }}</li>
  </ol>
</nav>

<div class="section product-page" style="padding-top:1.5rem;">
  <div class="container">
    <div class="product-page__grid">

      <!-- Image gallery -->
      <div class="product-page__media reveal">

        {%- comment -%}
          Mobile: swipe-first gallery with dot indicators. Full-width slides,
          object-fit:contain on a neutral frame so the whole planter is always
          visible (no aggressive crop) regardless of photo aspect ratio.
        {%- endcomment -%}
        {%- if product.media.size > 0 -%}
          <div class="pg-mobile">
            <div class="pg-rail" id="PgRail" tabindex="0" role="group" aria-label="Product media gallery — swipe to browse">
              {%- for media in product.media -%}
                <div class="pg-slide" data-media-id="{{ media.id }}" data-media-type="{{ media.media_type }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 900 }}"
                        srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w"
                        sizes="100vw"
                        alt="{{ media.alt | default: product.title | escape }}"
                        width="{{ media.width }}"
                        height="{{ media.height }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        {% if forloop.first %}fetchpriority="high"{% endif %}
                      >
                    {%- when 'video' -%}
                      {{ media | video_tag: image_size: '900x', controls: true, autoplay: false, loop: false, muted: false, preload: 'metadata' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag: loading: 'lazy' }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag }}
                    {%- else -%}
                      {{ media | media_tag }}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </div>
            {%- if product.media.size > 1 -%}
              <div class="pg-dots" id="PgDots">
                {%- for media in product.media -%}
                  <button type="button" class="pg-dot{% if forloop.first %} is-active{% endif %}" data-idx="{{ forloop.index0 }}" data-media-id="{{ media.id }}" aria-label="Show media {{ forloop.index }} of {{ product.media.size }}"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Desktop: main image + thumbnail click-to-swap (preserved) {%- endcomment -%}
        <div class="pg-desktop">
          <div class="pg-main img-zoom-wrap media-wrapper aspect-5-4 shadow-soft" style="border-radius:var(--radius-lg); overflow:hidden;">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="pg-main-slide{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" data-media-type="{{ media.media_type }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 1200 }}"
                        srcset="{{ media | image_url: width: 600 }} 600w,
                                {{ media | image_url: width: 1200 }} 1200w"
                        sizes="55vw"
                        alt="{{ media.alt | default: product.title | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        width="{{ media.width }}"
                        height="{{ media.height }}"
                        class="pg-main-img"
                      >
                    {%- when 'video' -%}
                      {{ media | video_tag: image_size: '1200x', controls: true, autoplay: false, loop: false, muted: false, preload: 'metadata' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag: loading: 'lazy' }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag }}
                    {%- else -%}
                      {{ media | media_tag }}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div style="width:100%;height:100%;min-height:28rem;background:var(--color-cedar-100);"></div>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <div class="product-thumbnails" role="list" aria-label="Product media">
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="product-thumb{% if forloop.first %} is-active{% endif %}{% unless media.media_type == 'image' %} product-thumb--playable{% endunless %}"
                  aria-label="View {{ media.media_type | replace: '_', ' ' }} {{ forloop.index }}"
                  data-media-id="{{ media.id }}"
                >
                  <img
                    src="{{ media.preview_image | image_url: width: 160 }}"
                    alt="{{ media.preview_image.alt | default: product.title | escape }}"
                    width="80"
                    height="{{ 80 | divided_by: media.preview_image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                  {%- unless media.media_type == 'image' -%}
                    <span class="product-thumb__play" aria-hidden="true"></span>
                  {%- endunless -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Product info -->
      <div class="product-page__info reveal reveal--delay-1">
        {%- if product.type != blank -%}
          <p class="eyebrow">{{ product.type }}</p>
        {%- endif -%}
        {%- if is_best_seller -%}
          <div class="cc-best-seller-badge" aria-label="Best seller">
            ★ Best Seller · Most-Purchased Cedar Planter
          </div>
        {%- endif -%}
        <h1 class="product-page__title">{{ product.title }}</h1>

        {%- if product.metafields.custom.dimensions != blank -%}
          <p style="margin-top:0.5rem; font-size:var(--text-sm); color:var(--color-text-faint);">{{ product.metafields.custom.dimensions }}</p>
        {%- endif -%}

        <!-- Price -->
        <div class="product-page__price" id="ProductPrice">
          {%- assign campaign_suffix = settings.campaign_eyebrow | default: 'Handcrafted in Vancouver' | split: '· ' | last | strip -%}
          {%- if settings.campaign_active and is_quote_only == false -%}
            <p class="campaign-sale-eyebrow{% unless is_on_sale %} is-hidden{% endunless %}" id="CampaignSaleEyebrow" data-label="{{ campaign_suffix | escape }}">{{ campaign_suffix }}</p>
          {%- endif -%}
          {%- if is_quote_only -%}
            <p class="price__starting-from">Starting at</p>
            <p class="price__original" id="ProductRegularPrice" style="font-size:1.75rem;">{{ display_price | money }} CAD</p>
          {%- elsif is_on_sale -%}
            <div class="price-block" id="ProductPriceBlock">
              <span class="price__original--strikethrough" id="ProductComparePrice">{{ display_compare | money }}</span>
              <span class="price__sale price__sale--lg" id="ProductSalePrice">{{ display_price | money }}</span>
              <span class="price__discount-badge">WORKSHOP PRICE</span>
            </div>
          {%- else -%}
            <p class="price__starting-from">Starting from</p>
            <p class="price__original" id="ProductRegularPrice" style="font-size:1.75rem;">{{ display_price | money }}</p>
          {%- endif -%}

          {%- if settings.campaign_active and is_on_sale and is_quote_only == false -%}
            <div class="workshop-batch">
              <p class="workshop-batch__label">
                Built to order · Typical lead time 3–5 business days
              </p>
              <p class="workshop-batch__sub">Handcrafted in Vancouver · Fully assembled, ready to plant</p>
            </div>
          {%- endif -%}

          <p class="product-page__delivery" style="margin-top:0.5rem; font-size:var(--text-sm); color:var(--color-text-faint);">
            {%- if ships_na -%}
              {{ settings.site_delivery_policy }}
            {%- else -%}
              Local delivery across eligible Greater Vancouver areas: FREE on orders CAD $200+; CAD $25 under $200. Pickup by appointment in North Vancouver.
            {%- endif -%}
          </p>
        </div>

        {%- unless is_quote_only -%}
          <ul class="buy-trust" role="list" aria-label="Product highlights">
            <li class="buy-trust__item">Fully Assembled</li>
            <li class="buy-trust__item">Handcrafted in North Vancouver</li>
            <li class="buy-trust__item">Free Local Delivery $200+</li>
            <li class="buy-trust__item">3-Year Warranty</li>
          </ul>
        {%- endunless -%}

        <!-- Variant selector, quantity, and add-to-cart — all inside one form -->
        {%- if is_quote_only -%}
          <div class="product-page__ctas">
            <a href="/pages/contact" class="btn btn--primary btn--lg" style="flex:1;">Request a Quote →</a>
            <a href="/pages/custom-planters" class="btn btn--secondary btn--lg" style="flex:1;">Request custom size</a>
          </div>
        {%- else -%}
          {%- form 'product', product, id: 'ProductForm', novalidate: 'novalidate' -%}

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="form-field" style="margin-top:1.25rem;">
                  <label class="form-label" for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                  <select
                    id="Option-{{ section.id }}-{{ forloop.index0 }}"
                    name="options[{{ option.name | escape }}]"
                    class="form-select cc-option-select"
                    aria-label="{{ option.name }}"
                  >
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <select name="id" id="ProductVariantId" class="visually-hidden" aria-hidden="true">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                  data-price="{{ variant.price }}"
                  data-compare="{{ variant.compare_at_price | default: 0 }}"
                  data-available="{{ variant.available }}"
                >{{ variant.title }}</option>
              {%- endfor -%}
            </select>

            <!-- Conditional stain colour field ─────────────────────────────────
                 Rendered ONLY for products that offer a custom-stain finish
                 (has_custom_stain). Then shown ONLY when that option is selected.
                 Submitted as line-item property → appears in cart, checkout,
                 order details, and confirmation email.
                 JS controls display, required, and disabled state.
            -->
            {%- if has_custom_stain -%}
            <div
              id="CCStainColourField"
              style="display:none; margin-top:1.25rem;"
              aria-hidden="true"
            >
              <label class="form-label" for="CCStainColour">
                Preferred stain colour
                <span class="form-required-marker" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="CCStainColour"
                name="properties[Preferred stain colour]"
                placeholder="Enter the colour name, brand, or stain code"
                class="form-input"
                autocomplete="off"
                disabled
                style="margin-top:0.375rem; width:100%;"
              >
              <p class="form-helper-text" style="margin-top:0.375rem; font-size:var(--text-xs); color:var(--color-text-faint);">
                Choose your preferred stain colour. Final colour will be confirmed before production.
              </p>
            </div>
            {%- endif -%}

            <div style="margin-top:1.25rem;">
              <label class="form-label" for="ProductQty">Quantity</label>
              <div class="quantity-selector" style="margin-top:0.5rem;">
                <button type="button" class="quantity-selector__btn" data-qty-dec aria-label="Decrease quantity">−</button>
                <input type="number" id="ProductQty" name="quantity" value="1" min="1" class="quantity-selector__input" aria-label="Quantity">
                <button type="button" class="quantity-selector__btn" data-qty-inc aria-label="Increase quantity">+</button>
              </div>
            </div>

            <div class="product-page__ctas">
              <button
                type="submit"
                name="add"
                id="ProductAddToCart"
                class="btn btn--primary btn--lg"
                style="flex:1;"
                {% unless product.available %}disabled{% endunless %}
              >
                {%- if product.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>
            <p class="cc-custom-size-link">Need different dimensions? <a href="/pages/custom-planters">Request a custom size →</a></p>

            <div class="product-page__accelerated-checkout" style="margin-top:0.75rem;">
              {{ form | payment_button }}
            </div>

          {%- endform -%}
          {%- unless template.suffix == 'conversion' -%}
            <div class="cc-buy-assurances" aria-label="Order assurances">
              <p><strong>Made to order.</strong> Most standard builds are ready in 3–5 business days.</p>
              <p><strong>Delivery:</strong> FREE locally on orders $200+ in eligible Greater Vancouver areas; CAD $25 under $200. Pickup in North Vancouver is free.</p>
              <p><strong>Warranty:</strong> Eligible products include our 3-Year Limited Structural Workmanship Warranty. <a href="/pages/warranty">View coverage →</a></p>
            </div>
          {%- endunless -%}
        {%- endif -%}

        {%- comment -%} Conversion prototype: key buy-area assurances + warranty link {%- endcomment -%}
        {%- if template.suffix == 'conversion' -%}
          <ul class="buy-points" role="list">
            <li>Fully assembled &amp; ready to plant — no tools, no assembly</li>
            <li>Handcrafted in Canada from premium-selected Western Cedar</li>
            <li>Custom sizing available for residential &amp; commercial spaces</li>
            {%- if ships_na -%}
              <li>Greater Vancouver delivery: FREE on orders CAD $200+ · CAD $25 under $200 · Canada shipping by quote</li>
            {%- else -%}
              <li>Local delivery across eligible Greater Vancouver areas: FREE on orders CAD $200+; CAD $25 under $200</li>
            {%- endif -%}
          </ul>
          {%- if ships_na -%}
            <p class="buy-ship-na">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7zM5.5 19a2 2 0 100 .01M18.5 19a2 2 0 100 .01"/></svg>
              Canada shipping by quote — fully assembled.
            </p>
          {%- endif -%}
          <p class="buy-warranty">
            <strong>3-Year Craftsmanship Warranty.</strong> Backed by our written 3-Year Limited Structural Workmanship Warranty.
            <a href="/pages/warranty" class="buy-warranty__link">Learn what&rsquo;s covered &rarr;</a>
          </p>
          {%- render 'product-review-proof' -%}

          <section class="product-comparison" aria-labelledby="ProductComparisonTitle-{{ section.id }}">
            <div class="product-comparison__heading">
              <p class="product-comparison__eyebrow">{{ 'products.product.comparison_eyebrow' | t }}</p>
              <h2 id="ProductComparisonTitle-{{ section.id }}" class="product-comparison__title">{{ 'products.product.comparison_title' | t }}</h2>
              <p class="product-comparison__intro">{{ 'products.product.comparison_intro' | t }}</p>
            </div>
            <div class="product-comparison__scroll" tabindex="0" role="region" aria-label="{{ 'products.product.comparison_label' | t }}">
              <table class="product-comparison__table">
                <thead>
                  <tr>
                    <th scope="col">{{ 'products.product.comparison_feature' | t }}</th>
                    <th scope="col" class="product-comparison__coastline">{{ 'products.product.comparison_coastline' | t }}</th>
                    <th scope="col">{{ 'products.product.comparison_kit' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th scope="row">{{ 'products.product.comparison_arrival' | t }}</th>
                    <td class="product-comparison__coastline">{{ 'products.product.comparison_arrival_us' | t }}</td>
                    <td>{{ 'products.product.comparison_arrival_kit' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'products.product.comparison_sizing' | t }}</th>
                    <td class="product-comparison__coastline">{{ 'products.product.comparison_sizing_us' | t }}</td>
                    <td>{{ 'products.product.comparison_sizing_kit' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'products.product.comparison_support' | t }}</th>
                    <td class="product-comparison__coastline">{{ 'products.product.comparison_support_us' | t }}</td>
                    <td>{{ 'products.product.comparison_support_kit' | t }}</td>
                  </tr>
                  <tr>
                    <th scope="row">{{ 'products.product.comparison_warranty' | t }}</th>
                    <td class="product-comparison__coastline">{{ 'products.product.comparison_warranty_us' | t }}</td>
                    <td>{{ 'products.product.comparison_warranty_kit' | t }}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>
        {%- endif -%}

        <!-- Delivery / pickup info -->
        <div class="info-box" style="margin-top:1.5rem;">
          <p style="font-weight:var(--font-medium); color:var(--color-text); margin-bottom:0.375rem;">Delivery & pickup</p>
          {%- if ships_na -%}
            <p>{{ settings.site_delivery_policy }}</p>
          {%- else -%}
            <p>Local delivery across eligible Greater Vancouver areas: FREE on orders CAD $200+; CAD $25 under $200. Pickup by appointment in North Vancouver.</p>
          {%- endif -%}
          <p style="margin-top:0.25rem; color:var(--color-text-faint); font-size:var(--text-xs);">Workshop in North Vancouver · {{ settings.site_hours }}</p>
          {%- if settings.site_phone != blank -%}
            <a href="{{ settings.site_phone_href }}" class="product-page__call-link" style="margin-top:0.5rem; display:inline-flex; align-items:center; gap:0.375rem; font-size:var(--text-sm); font-weight:var(--font-medium); color:var(--color-cedar-700); text-decoration:none;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.00 1.18 2 2 0 012 .02h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              Call us: {{ settings.site_phone }}
            </a>
          {%- endif -%}
        </div>

        <!-- Spec table -->
        <dl class="spec-table" style="margin-top:2rem;">
          {%- if product.metafields.custom.dimensions != blank -%}
            <div class="spec-table__row"><dt class="spec-table__key">Planter</dt><dd class="spec-table__value">{{ product.metafields.custom.dimensions }}</dd></div>
          {%- endif -%}
          {%- if product.metafields.custom.trellis_dimensions != blank -%}
            <div class="spec-table__row"><dt class="spec-table__key">Trellis</dt><dd class="spec-table__value">{{ product.metafields.custom.trellis_dimensions }}</dd></div>
          {%- endif -%}
          <div class="spec-table__row"><dt class="spec-table__key">Material</dt><dd class="spec-table__value">{{ product.metafields.custom.material | default: 'Premium British Columbia Western Cedar' }}</dd></div>
          {%- if product.metafields.custom.drainage != blank -%}
            <div class="spec-table__row"><dt class="spec-table__key">Drainage</dt><dd class="spec-table__value">{{ product.metafields.custom.drainage }}</dd></div>
          {%- endif -%}
          <div class="spec-table__row"><dt class="spec-table__key">Delivery condition</dt><dd class="spec-table__value">Fully assembled — ready to plant</dd></div>
          <div class="spec-table__row"><dt class="spec-table__key">Build time</dt><dd class="spec-table__value">{{ product.metafields.custom.build_time | default: 'Most standard builds are ready in 3–5 business days after order details are confirmed' }}</dd></div>
        </dl>
      </div>
    </div>

    <!-- Description, features, best for -->
    <div class="product-page__details reveal">
      <div class="product-page__description">
        <h2>About this planter</h2>
        {%- if product.description != blank -%}
          <div style="margin-top:1rem; color:var(--color-text-muted); line-height:1.75;">{{ product.description }}</div>
        {%- endif -%}

        {%- if product.metafields.custom.features != blank -%}
          <h3 style="margin-top:2.5rem;">Features</h3>
          <ul class="product-page__features">
            {%- for feature in product.metafields.custom.features.value -%}
              <li class="product-page__feature">
                <span class="product-page__feature-dot" aria-hidden="true"></span>
                {{ feature }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if product.metafields.custom.best_for != blank -%}
          <h3 style="margin-top:2.5rem;">Best for</h3>
          <div class="tag-list" style="margin-top:0.75rem;">
            {%- for use in product.metafields.custom.best_for.value -%}
              <span class="tag">{{ use }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- FAQ sidebar -->
      <aside>
        <h3 style="font-family:var(--font-display); font-size:var(--text-xl); font-weight:var(--font-semibold);">Questions about this planter</h3>
        <div class="accordion" style="margin-top:1rem;">
          {%- assign product_faqs = 'Is this size in stock?|We build to order. Most standard builds are ready in 3–5 business days after order details are confirmed.,Can I get this in a different size?|Yes. Send us the dimensions you need and we will quote a custom version.,How does delivery work?|Pickup by appointment in North Vancouver. Local delivery across eligible Greater Vancouver areas: FREE on orders CAD $200+; CAD $25 under $200. Shipping outside Greater Vancouver may be available by quote.,Do you assemble on delivery?|Yes — planters arrive fully assembled and ready to fill with soil.' | split: ',' -%}
          {%- for faq in product_faqs -%}
            {%- assign parts = faq | split: '|' -%}
            <div class="accordion__item">
              <button type="button" class="accordion__trigger" aria-expanded="false">
                <span>{{ parts[0] }}</span>
                <span class="accordion__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </button>
              <div class="accordion__body">{{ parts[1] }}</div>
            </div>
          {%- endfor -%}
        </div>
      </aside>
    </div>

    <!-- Related products -->
    {%- if section.settings.show_related -%}
      {%- assign related = recommendations.products -%}
      {%- if related.size == 0 -%}
        {%- assign related = collections.all.products | where: 'id', product.id | map: 'id' -%}
      {%- endif -%}
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="product-page__related reveal">
          <h2>You might also like</h2>
          <div class="product-page__related-grid" style="margin-top:2rem;">
            {%- for p in recommendations.products limit: 4 -%}
              {%- render 'product-card', product: p, columns: 4 -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

<!-- Sticky mobile ATC bar — hidden on desktop -->
{%- unless is_quote_only -%}
<div class="sticky-atc" id="StickyATC" aria-hidden="true">
  <div class="sticky-atc__inner container">
    <div class="sticky-atc__info">
      <p class="sticky-atc__title">{{ product.title }}</p>
      <p class="sticky-atc__price" id="StickyATCPrice">{%- if is_on_sale -%}<s>{{ display_compare | money }}</s> <strong>{{ display_price | money }}</strong>{%- else -%}<strong>{{ display_price | money }}</strong>{%- endif -%}</p>
    </div>
    <button type="button" class="btn btn--primary" id="StickyATCBtn" onclick="document.getElementById('ProductAddToCart').click();"
      {% unless product.available %}disabled{% endunless %}>
      {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
    </button>
  </div>
</div>
<style>
.sticky-atc {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid var(--color-border);
  padding: 0.75rem 0 calc(0.75rem + env(safe-area-inset-bottom, 0px));
  z-index: 200;
  box-shadow: 0 -2px 12px rgba(0,0,0,0.08);
  transform: translateY(100%);
  transition: transform 0.25s ease;
}
@media (prefers-reduced-motion: reduce) { .sticky-atc { transition: none; } }
.sticky-atc.is-visible { transform: translateY(0); }
@media (max-width: 767px) {
  .sticky-atc { display: block; }
  /* Prevent sticky ATC from permanently covering footer content on mobile */
  .site-footer__bottom { padding-bottom: calc(5rem + env(safe-area-inset-bottom, 0px)); }
}
.sticky-atc__inner { display: flex; align-items: center; gap: 1rem; justify-content: space-between; }
.sticky-atc__title { font-weight: var(--font-medium); font-size: var(--text-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 55vw; }
.sticky-atc__price { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: 0.125rem; }

/* Coastline Cedar mobile product gallery fit fix */
@media (max-width: 767px) {
  .product-page__media,
  .pg-mobile,
  .pg-rail,
  .pg-slide {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .product-page__media {
    min-width: 0;
    overflow: hidden;
  }
  .pg-mobile {
    display: block;
    overflow: hidden;
  }
  .pg-desktop { display: none; }
  .pg-rail {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .pg-rail::-webkit-scrollbar { display: none; }
  .pg-slide {
    flex: 0 0 100%;
    width: 100%;
    max-width: 100%;
    min-width: 100%;
    min-height: 260px;
    max-height: 68vh;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: center;
    background: var(--color-bone);
    overflow: hidden;
  }
  .pg-slide img,
  .pg-slide video,
  .pg-slide iframe,
  .pg-slide model-viewer {
    display: block;
    width: auto !important;
    height: auto !important;
    max-width: 100% !important;
    max-height: calc(68vh - 20px) !important;
    object-fit: contain !important;
    margin: 0 auto;
  }
}

</style>
<script>
(function(){
  var bar = document.getElementById('StickyATC');
  var atcBtn = document.getElementById('ProductAddToCart');
  if (!bar || !atcBtn) return;
  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) {
        bar.classList.add('is-visible');
        bar.setAttribute('aria-hidden','false');
      } else {
        bar.classList.remove('is-visible');
        bar.setAttribute('aria-hidden','true');
      }
    });
  }, { threshold: 0 });
  observer.observe(atcBtn);
})();
</script>
