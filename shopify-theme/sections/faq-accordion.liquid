<section class="section section--{{ section.settings.background }} faq-section">
  <div class="container" style="max-width: 52rem; margin-inline: auto;">
    <div class="reveal" style="text-align: {{ section.settings.align }};">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="faq-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="accordion reveal reveal--delay-1" role="list" style="margin-top: 2.5rem;">
      {%- for block in section.blocks -%}
        <div class="accordion__item" role="listitem" {{ block.shopify_attributes }}>
          <button
            type="button"
            class="accordion__trigger"
            aria-expanded="false"
            aria-controls="faq-answer-{{ section.id }}-{{ forloop.index }}"
            id="faq-question-{{ section.id }}-{{ forloop.index }}"
          >
            <span>{{ block.settings.question }}</span>
            <span class="accordion__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </span>
          </button>
          <div
            class="accordion__body"
            id="faq-answer-{{ section.id }}-{{ forloop.index }}"
            role="region"
            aria-labelledby="faq-question-{{ section.id }}-{{ forloop.index }}"
          >
            {{ block.settings.answer }}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <p class="reveal" style="text-align: center; margin-top: 2rem;">
        <a href="{{ section.settings.cta_url }}" class="link-arrow">{{ section.settings.cta_label }} →</a>
      </p>
    {%- endif -%}
  </div>
</section>

<style>
.faq-section__heading { margin-top: 0.75rem; }
</style>

{% schema %}
{
  "name": "FAQ accordion",
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "bone", "label": "Bone" }
      ],
      "default": "bone"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Frequently asked" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions." },
    { "type": "text", "id": "cta_label", "label": "Link label" },
    { "type": "url", "id": "cta_url", "label": "Link URL" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What sizes do you offer?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We have four standard sizes — balcony, patio, raised garden, and privacy — plus commercial project quotes and made-to-measure custom builds.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "faq", "settings": { "question": "What sizes do you offer?", "answer": "<p>Seven standard sizes covering patio, balcony, large outdoor, raised garden, privacy, commercial, and custom. Standard sizes start at 24″ long and go up to 60″+ for privacy planters and commercial use.</p>" } },
        { "type": "faq", "settings": { "question": "Do you build custom sizes?", "answer": "<p>Yes — custom is one of the things we do best. Send us the length, width, and height you need — plus a photo of the space — and we'll come back with a sketch, quote, and timeline within 1–2 business days.</p>" } },
        { "type": "faq", "settings": { "question": "What wood do you use?", "answer": "<p>Kiln-dried Western Cedar, locally sourced. Western Cedar is naturally rot-resistant, contains natural oils that repel insects, and ages beautifully in our wet climate.</p>" } },
        { "type": "faq", "settings": { "question": "Do you deliver in Greater Vancouver?", "answer": "<p>Yes. We deliver across North Vancouver, West Vancouver, Vancouver, Burnaby, Richmond, Coquitlam, Port Coquitlam, Port Moody, New Westminster, Surrey, Delta, and Langley. Free pickup by appointment in North Vancouver. Local delivery: CAD $25.</p>" } },
        { "type": "faq", "settings": { "question": "How long does an order take?", "answer": "<p>Most standard builds are ready in 3–5 business days after order details are confirmed. For larger projects, the timeline depends on project size, measurements, site access, and installation scope.</p>" } }
      ]
    }
  ]
}
{% endschema %}
