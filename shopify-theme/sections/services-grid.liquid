<section class="section section--{{ section.settings.background }} services-grid">
  <div class="container">
    <div class="services-grid__header reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="services-grid__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="services-grid__cards">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.url | default: '#' }}" class="service-card reveal reveal--delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="service-card__image img-zoom-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                        {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                class="img-cover"
              >
            {%- elsif block.settings.fallback_asset != blank -%}
              <img
                src="{{ block.settings.fallback_asset | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                width="800"
                height="600"
                loading="lazy"
                class="img-cover"
              >
            {%- else -%}
              <div style="width:100%;height:100%;min-height:16rem;background:var(--color-cedar-100);"></div>
            {%- endif -%}

            {%- if settings.promo_active and block.settings.show_promo_badge -%}
              <span class="product-card__status-badge product-card__status-badge--promo">{{ settings.promo_label }}</span>
            {%- endif -%}
          </div>

          <div class="service-card__body">
            {%- if block.settings.title != blank -%}
              <h3 class="service-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.blurb != blank -%}
              <p class="service-card__blurb">{{ block.settings.blurb }}</p>
            {%- endif -%}

            <div class="service-card__price">
              {%- if block.settings.price_label != blank -%}
                <div>
                  {%- if block.settings.starting_from -%}
                    <p class="price__starting-from">Starting from</p>
                  {%- endif -%}
                  {%- if settings.promo_active and block.settings.sale_price != blank -%}
                    <div class="price-block">
                      {%- if block.settings.original_price != blank -%}
                        <span class="price__original--strikethrough">{{ block.settings.original_price }}</span>
                      {%- endif -%}
                      <span class="price__sale">{{ block.settings.sale_price }}</span>
                    </div>
                  {%- else -%}
                    <p class="price__original">{{ block.settings.price_label }}</p>
                  {%- endif -%}
                </div>
              {%- else -%}
                <p class="price__quote">Quote on request</p>
              {%- endif -%}
              <span class="service-card__cta">{{ block.settings.cta_label | default: 'Learn more' }} →</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.services-grid__header { margin-bottom: 2.5rem; }
.services-grid__heading { margin-top: 0.75rem; }
.services-grid__cards {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: 1fr;
}
@media (min-width: 640px) { .services-grid__cards { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .services-grid__cards { grid-template-columns: repeat(3, 1fr); } }
</style>

{% schema %}
{
  "name": "Services grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "bone", "label": "Bone" }
      ],
      "default": "bone"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Beyond planters" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More custom cedar builds" }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback image (theme/assets filename)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cedar Privacy Panels" },
        { "type": "textarea", "id": "blurb", "label": "Short description", "default": "Standalone cedar screens for patios, balconies, hot tubs, and side yards. Custom heights and widths." },
        { "type": "text", "id": "price_label", "label": "Price label", "default": "$399" },
        { "type": "text", "id": "original_price", "label": "Original price (for strikethrough)" },
        { "type": "text", "id": "sale_price", "label": "Sale price" },
        { "type": "checkbox", "id": "starting_from", "label": "Show 'Starting from'", "default": true },
        { "type": "checkbox", "id": "show_promo_badge", "label": "Show promo badge", "default": true },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Learn more" },
        { "type": "url", "id": "url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services grid",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "fallback_asset": "service-privacy-panel-deck.jpg",
            "title": "Cedar Privacy Panels",
            "blurb": "Standalone cedar screens for patios, balconies, hot tubs, and side yards. Custom heights and widths.",
            "price_label": "$399",
            "original_price": "$399",
            "sale_price": "$239",
            "starting_from": true,
            "cta_label": "Get a Quote"
          }
        },
        {
          "type": "service",
          "settings": {
            "fallback_asset": "service-outdoor-sauna.jpg",
            "title": "Custom Outdoor Saunas",
            "blurb": "Built-to-order backyard cedar saunas with a modern West Coast look. Quoted after a site review.",
            "price_label": "$8,500",
            "original_price": "$8,500",
            "sale_price": "$5,100",
            "starting_from": true,
            "cta_label": "Request a Quote"
          }
        },
        {
          "type": "service",
          "settings": {
            "fallback_asset": "service-cedar-gate-fence.jpg",
            "title": "Cedar Gates & Fences",
            "blurb": "Handmade cedar garden gates, side-yard gates, and custom fence panels. Built and finished locally.",
            "price_label": "$950",
            "original_price": "$950",
            "sale_price": "$570",
            "starting_from": true,
            "cta_label": "Get a Quote"
          }
        }
      ]
    }
  ]
}
{% endschema %}
