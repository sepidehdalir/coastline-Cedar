<div class="section">
  <div class="container">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <p style="margin-top: 0.5rem;"><a href="{{ routes.account_logout_url }}" class="text-accent">Sign out</a></p>
    <h2 style="margin-top: 2rem;">{{ 'customer.orders.title' | t }}</h2>
    {%- if customer.orders.size > 0 -%}
      <table style="width:100%;margin-top:1rem;border-collapse:collapse;font-size:var(--text-sm);">
        <thead><tr>
          <th style="text-align:left;padding:0.5rem;border-bottom:1px solid var(--color-border);">{{ 'customer.orders.order_number' | t }}</th>
          <th style="text-align:left;padding:0.5rem;border-bottom:1px solid var(--color-border);">{{ 'customer.orders.date' | t }}</th>
          <th style="text-align:left;padding:0.5rem;border-bottom:1px solid var(--color-border);">{{ 'customer.orders.total' | t }}</th>
        </tr></thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td style="padding:0.5rem;border-bottom:1px solid var(--color-border);"><a href="{{ order.customer_url }}" class="text-accent">{{ order.name }}</a></td>
              <td style="padding:0.5rem;border-bottom:1px solid var(--color-border);">{{ order.created_at | date: '%B %e, %Y' }}</td>
              <td style="padding:0.5rem;border-bottom:1px solid var(--color-border);">{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p style="margin-top:1rem;color:var(--color-text-muted);">No orders yet.</p>
    {%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
