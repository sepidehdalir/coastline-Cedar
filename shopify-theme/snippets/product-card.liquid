{%- comment -%}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
  Optional: columns: 2|3|4 (controls image sizes attribute)
{%- endcomment -%}

{%- liquid
  comment
    is_quote_only: only true when custom.quote_only metafield is explicitly "true".
    Never inferred from price, inventory, product type, title, or collection.
  endcomment
  assign is_quote_only = false
  if product.metafields.custom.quote_only == 'true'
    assign is_quote_only = true
  endif

  comment
    Availability: use product.available (honours "continue selling when out of stock")
    Never use inventory_quantity alone.
  endcomment
  assign sold_out = false
  unless product.available
    assign sold_out = true
  endunless

  comment
    Price display: find the minimum priced variant with price > 0.
    All 6 products have a "Natural (unfinished)" variant at $0 which must not be used
    as the display price. We loop variants and pick the first one priced above zero.
    Fallback to product.price if every variant is $0.
  endcomment
  assign display_price   = 0
  assign display_compare = 0
  for variant in product.variants
    if variant.price > 0 and display_price == 0
      assign display_price   = variant.price
      assign display_compare = variant.compare_at_price
    endif
  endfor
  if display_price == 0
    assign display_price   = product.price
    assign display_compare = product.compare_at_price
  endif

  assign is_on_sale = false
  if display_compare > display_price
    assign is_on_sale = true
  endif

  assign discount_pct = 0
  if is_on_sale
    assign discount_pct = display_compare | minus: display_price | times: 100 | divided_by: display_compare
  endif

  assign columns   = columns | default: 4
  assign img_sizes = '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 90vw'
  if columns == 3
    assign img_sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 90vw'
  elsif columns == 2
    assign img_sizes = '(min-width: 640px) 50vw, 90vw'
  endif
-%}

<a href="{{ product.url }}" class="product-card" aria-label="{{ product.title | escape }}">

  <div class="product-card__image">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                {{ product.featured_image | image_url: width: 600 }} 600w,
                {{ product.featured_image | image_url: width: 900 }} 900w"
        sizes="{{ img_sizes }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        class="img-cover"
      >
    {%- else -%}
      <div class="product-card__no-image" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9l4-4 4 4 4-6 4 4"/>
        </svg>
      </div>
    {%- endif -%}

    {%- if product.type != blank -%}
      <span class="product-card__badge">{{ product.type }}</span>
    {%- endif -%}

    {%- if sold_out -%}
      <span class="product-card__status-badge product-card__status-badge--soldout">{{ 'products.product.sold_out' | t }}</span>
    {%- elsif is_on_sale and is_quote_only == false -%}
      <span class="product-card__status-badge product-card__status-badge--promo">SAVE {{ discount_pct }}%</span>
    {%- endif -%}
  </div>

  <div class="product-card__body">
    <h3 class="product-card__title">{{ product.metafields.custom.card_title | default: product.title }}</h3>

    {%- if product.metafields.custom.dimensions != blank -%}
      <p class="product-card__dimensions">{{ product.metafields.custom.dimensions }}</p>
    {%- endif -%}

    {%- if product.description != blank -%}
      <p class="product-card__description">{{ product.description | strip_html | truncate: 90 }}</p>
    {%- endif -%}

    <div class="product-card__footer">
      <div>
        {%- if is_quote_only -%}
          <p class="price__quote">{{ 'products.product.request_quote' | t }}</p>
        {%- elsif sold_out -%}
          <p class="price__sold-out">{{ 'products.product.sold_out' | t }}</p>
        {%- elsif is_on_sale -%}
          <div class="price-block">
            <span class="price__original--strikethrough">{{ display_compare | money }}</span>
            <span class="price__sale">{{ display_price | money }}</span>
          </div>
        {%- else -%}
          <p class="price__starting-from">{{ 'products.product.from' | t }}</p>
          <p class="price__original">{{ display_price | money }}</p>
        {%- endif -%}
      </div>

      <span class="product-card__view" aria-hidden="true">
        {%- if is_quote_only -%}
          Request a quote →
        {%- elsif sold_out -%}
          Sold out
        {%- elsif product.variants.size == 1 -%}
          Add to cart →
        {%- else -%}
          Choose options →
        {%- endif -%}
      </span>
    </div>

    {%- unless is_quote_only or sold_out -%}
      <p class="product-card__delivery-note">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Pickup or local delivery
      </p>
    {%- else -%}
      <p class="product-card__delivery-note">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        Free quote · 1–2 business days
      </p>
    {%- endunless -%}
  </div>

</a>

<style>
.product-card__no-image {
  width: 100%;
  height: 100%;
  min-height: 12rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-cedar-100);
  color: var(--color-cedar-400);
}

.product-card__status-badge {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-full);
  font-size: 0.62rem;
  font-weight: var(--font-semibold);
  letter-spacing: 0.10em;
  text-transform: uppercase;
}

.product-card__status-badge--promo {
  background-color: var(--color-forest-600);
  color: var(--color-cream);
}

.product-card__status-badge--soldout {
  background-color: var(--color-charcoal-900);
  color: var(--color-cream);
}

.price__sold-out {
  font-size: var(--text-sm);
  color: var(--color-text-faint);
}

.product-card__delivery-note {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  margin-top: 0.625rem;
  padding-top: 0.625rem;
  border-top: 1px solid var(--color-border-light);
  font-size: 0.75rem;
  color: var(--color-text-faint);
}
</style>
