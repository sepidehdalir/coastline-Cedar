<div class="section">
  <div class="container" style="max-width: 28rem;">
    <h1>{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', id: 'CreateCustomerForm' -%}
      {%- if form.errors -%}
        <div class="form-error-box" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-grid form-grid--2" style="margin-top: 1.5rem;">
        <div class="form-field">
          <label class="form-label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name" class="form-input">
        </div>
        <div class="form-field">
          <label class="form-label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name" class="form-input">
        </div>
      </div>
      <div class="form-field" style="margin-top: 1rem;">
        <label class="form-label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input type="email" id="RegisterEmail" name="customer[email]" autocomplete="email" class="form-input" required>
      </div>
      <div class="form-field" style="margin-top: 1rem;">
        <label class="form-label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" class="form-input" required>
      </div>
      <button type="submit" class="btn btn--primary btn--full" style="margin-top: 1.5rem;">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
