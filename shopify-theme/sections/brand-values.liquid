<section class="section section--bone brand-values">
  <div class="container">
    <div class="brand-values__grid">

      <div class="brand-values__intro">
        <p class="eyebrow">{{ section.settings.eyebrow | default: 'Why Coastline' }}</p>
        <h2 class="brand-values__heading">{{ section.settings.heading | default: 'Built locally. Built right.' }}</h2>
        <p class="brand-values__body">{{ section.settings.body | default: 'Every planter is built by hand from kiln-dried Western Cedar in our North Vancouver workshop. Real wood, real craftsmanship, real local delivery.' }}</p>
      </div>

      <div class="brand-values__cards">
        {%- for block in section.blocks -%}
          <div class="brand-values__card" {{ block.shopify_attributes }}>
            <h3 class="brand-values__card-title">{{ block.settings.title }}</h3>
            <p class="brand-values__card-body">{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<style>
.brand-values__grid {
  display: grid;
  gap: 3rem;
  align-items: center;
}

@media (min-width: 1024px) { .brand-values__grid { grid-template-columns: 5fr 7fr; } }

.brand-values__heading { margin-top: 0.75rem; }

.brand-values__body {
  margin-top: 1.25rem;
  max-width: 28rem;
  color: var(--color-text-muted);
}

.brand-values__cards {
  display: grid;
  gap: 1.25rem;
  grid-template-columns: 1fr;
}

@media (min-width: 640px) { .brand-values__cards { grid-template-columns: repeat(2, 1fr); } }

.brand-values__card {
  padding: 1.5rem;
  background: #ffffff;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.brand-values__card-title {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text);
  margin-bottom: 0.5rem;
}

.brand-values__card-body { font-size: var(--text-sm); color: var(--color-text-muted); }
</style>

{% schema %}
{
  "name": "Brand values",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why Coastline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built locally. Built right."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Every planter is built by hand from kiln-dried Western Cedar in our North Vancouver workshop. Real wood, real craftsmanship, real local delivery."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hand-built locally"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Made in North Vancouver from kiln-dried Western Cedar."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand values",
      "blocks": [
        { "type": "value", "settings": { "title": "Hand-built locally", "body": "Made in North Vancouver from kiln-dried Western Cedar." } },
        { "type": "value", "settings": { "title": "Made to last", "body": "Stainless fasteners, reinforced corners, and proper drainage on every build." } },
        { "type": "value", "settings": { "title": "Custom sizes", "body": "Send us length, width, and height — we build to spec, every time." } },
        { "type": "value", "settings": { "title": "Pickup or delivery", "body": "Pickup by appointment in North Vancouver. Delivery available across Metro Vancouver." } }
      ]
    }
  ]
}
{% endschema %}
