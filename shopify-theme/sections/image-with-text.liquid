<section class="section section--{{ section.settings.background }} image-with-text">
  <div class="container">
    <div class="image-with-text__grid image-with-text__grid--{{ section.settings.image_position }}">

      <div class="image-with-text__media">
        <div class="media-wrapper aspect-4-3 shadow-soft" style="border-radius: var(--radius-lg);">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 900 }}"
              srcset="{{ section.settings.image | image_url: width: 450 }} 450w,
                      {{ section.settings.image | image_url: width: 900 }} 900w"
              sizes="(min-width: 1024px) 45vw, 90vw"
              alt="{{ section.settings.image.alt | default: section.settings.heading }}"
              width="900"
              height="{{ 900 | divided_by: section.settings.image.aspect_ratio | round }}"
              loading="lazy"
              class="img-cover"
            >
          {%- else -%}
            <div style="width:100%;height:100%;min-height:20rem;background:var(--color-cedar-100);"></div>
          {%- endif -%}
        </div>
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <div class="image-with-text__body">{{ section.settings.body }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
          <a href="{{ section.settings.button_url }}" class="btn btn--primary" style="margin-top: 1.75rem;">
            {{ section.settings.button_label }} →
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
.image-with-text__grid {
  display: grid;
  gap: 2.5rem;
  align-items: center;
}

@media (min-width: 1024px) {
  .image-with-text__grid { grid-template-columns: 1fr 1fr; gap: 3.5rem; }
  .image-with-text__grid--right .image-with-text__media { order: 2; }
  .image-with-text__grid--right .image-with-text__content { order: 1; }
}

.image-with-text__heading { margin-top: 0.75rem; }

.image-with-text__body {
  margin-top: 1.25rem;
  color: var(--color-text-muted);
  line-height: 1.75;
}

.image-with-text__body p + p { margin-top: 1rem; }

.shadow-soft { box-shadow: var(--shadow-soft); }
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "bone",  "label": "Bone" }
      ],
      "default": "bone"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
