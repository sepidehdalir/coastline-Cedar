{%- if settings.promo_active -%}
<div class="announcement-bar" role="region" aria-label="Promotion">
  <div class="container">
    <div class="announcement-bar__inner">
      <p class="announcement-bar__text">
        <strong class="announcement-bar__label">{{ settings.promo_label }}</strong>
        all cedar builds until {{ settings.promo_end_label }}.
      </p>
      {%- if settings.promo_cta_url != blank -%}
        <a href="{{ settings.promo_cta_url }}" class="announcement-bar__cta">
          {{ settings.promo_cta_label }} →
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
{%- elsif settings.site_announcement != blank -%}
<div class="announcement-bar announcement-bar--evergreen" role="region" aria-label="Store information">
  <div class="container">
    <div class="announcement-bar__inner">
      <p class="announcement-bar__text">{{ settings.site_announcement }}</p>
      <a href="{{ routes.root_url }}pages/contact" class="announcement-bar__cta">Order Now →</a>
    </div>
  </div>
</div>
{%- endif -%}

<style>
.announcement-bar {
  background-color: var(--color-forest-600);
  color: var(--color-cream);
}

.announcement-bar--evergreen {
  background-color: var(--color-cedar-800, #5c3d1e);
  color: var(--color-cream);
}

.announcement-bar__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem 1rem;
  padding-block: 0.625rem;
  text-align: center;
}

@media (min-width: 640px) {
  .announcement-bar__inner { flex-direction: row; }
}

.announcement-bar__text {
  font-size: 0.875rem;
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-cream);
}

.announcement-bar__label {
  font-weight: 600;
}

.announcement-bar__cta {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 1rem;
  border-radius: var(--radius-full);
  background-color: var(--color-cream);
  color: var(--color-forest-700);
  font-size: 0.75rem;
  font-weight: 600;
  text-decoration: none;
  transition: background-color var(--transition-fast);
  white-space: nowrap;
}

.announcement-bar__cta:hover {
  background-color: var(--color-cedar-100);
}
</style>

{% schema %}
{
  "name": "Announcement bar",
  "limit": 1
}
{% endschema %}
