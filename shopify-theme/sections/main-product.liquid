<script>
document.addEventListener('DOMContentLoaded', function () {

  /* ── Media gallery (desktop): thumbnail → activate matching main slide by media id ─ */
  var pgMainSlides = Array.prototype.slice.call(document.querySelectorAll('.pg-main-slide'));
  var mediaThumbs  = Array.prototype.slice.call(document.querySelectorAll('.product-thumb'));
  function pgActivateMedia(id) {
    id = String(id);
    pgMainSlides.forEach(function (s) {
      var on = s.getAttribute('data-media-id') === id;
      s.classList.toggle('is-active', on);
      if (!on) { var vid = s.querySelector('video'); if (vid && !vid.paused) vid.pause(); }
    });
    mediaThumbs.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-media-id') === id); });
  }
  if (pgMainSlides.length && mediaThumbs.length) {
    mediaThumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () { pgActivateMedia(thumb.getAttribute('data-media-id')); });
    });
  }

  /* iOS inline playback for gallery videos (native controls, no autoplay) */
  Array.prototype.slice.call(document.querySelectorAll('.product-page__media video')).forEach(function (v) {
    v.setAttribute('playsinline', '');
    v.setAttribute('webkit-playsinline', '');
    v.removeAttribute('autoplay');
  });

  /* ── Mobile swipe gallery: sync dots with the scrolled slide ─ */
  var pgRail = document.getElementById('PgRail');
  var pgDots = pgRail ? Array.prototype.slice.call(document.querySelectorAll('#PgDots .pg-dot')) : [];
  if (pgRail && pgDots.length) {
    var pgSlides = Array.prototype.slice.call(pgRail.querySelectorAll('.pg-slide'));
    function pgSetActive(i) {
      pgDots.forEach(function (d, di) { d.classList.toggle('is-active', di === i); });
    }
    // Tap a dot → scroll that slide into view
    pgDots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var i = parseInt(dot.dataset.idx, 10) || 0;
        if (pgSlides[i]) pgSlides[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });
    });
    // Swipe/scroll → highlight the current slide (observe within the rail)
    if ('IntersectionObserver' in window) {
      var pgObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            var idx = pgSlides.indexOf(e.target);
            if (idx > -1) pgSetActive(idx);
          }
        });
      }, { root: pgRail, threshold: 0.6 });
      pgSlides.forEach(function (s) { pgObs.observe(s); });
    }
  }

  /* ── Variant selector sync ─────────────────────────────── */
  var variantsEl = document.getElementById('CCProductVariants');
  if (!variantsEl) return;
  var variants = JSON.parse(variantsEl.textContent);

  var form          = document.getElementById('ProductForm');
  var variantIdSel  = document.getElementById('ProductVariantId');
  var addBtn        = document.getElementById('ProductAddToCart');
  var optionSelects = form ? Array.from(form.querySelectorAll('.cc-option-select')) : [];

  /* Money formatter — matches Shopify's | money filter output for CAD */
  function money(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  function findVariant() {
    var vals = optionSelects.map(function (s) { return s.value; });
    return variants.find(function (v) {
      return v.options.every(function (opt, i) { return opt === vals[i]; });
    });
  }

  function updatePriceDisplay(v) {
    var price    = v.price;
    var compare  = v.compare_at_price || 0;
    var isOnSale = compare > price;

    var saleEl     = document.getElementById('ProductSalePrice');
    var strikeEl   = document.getElementById('ProductComparePrice');
    var regularEl  = document.getElementById('ProductRegularPrice');
    var startEl    = document.querySelector('.price__starting-from');
    var priceBlock = document.getElementById('ProductPriceBlock');
    var badgeEl    = document.querySelector('.price__discount-badge');
    var eyebrowEl  = document.getElementById('CampaignSaleEyebrow');

    if (isOnSale) {
      var discountPct = Math.floor((compare - price) * 100 / compare);
      if (priceBlock)  priceBlock.style.display = '';
      if (saleEl)    { saleEl.textContent = money(price);     saleEl.style.display = ''; }
      if (strikeEl)  { strikeEl.textContent = money(compare); strikeEl.style.display = ''; }
      if (badgeEl)     badgeEl.textContent = 'WORKSHOP PRICE';
      if (regularEl)   regularEl.style.display = 'none';
      if (startEl)     startEl.style.display = 'none';
      if (eyebrowEl) {
        eyebrowEl.textContent = (eyebrowEl.dataset.label || 'Handcrafted in Vancouver');
        eyebrowEl.classList.remove('is-hidden');
      }
    } else {
      if (priceBlock)  priceBlock.style.display = 'none';
      if (saleEl)      saleEl.style.display = 'none';
      if (strikeEl)    strikeEl.style.display = 'none';
      if (regularEl) { regularEl.textContent = money(price); regularEl.style.display = ''; }
      if (startEl)     startEl.style.display = '';
      if (eyebrowEl)   eyebrowEl.classList.add('is-hidden');
    }
  }

  /* Show or hide the "Preferred stain colour" line-item property field.
     The field is only relevant — and only required — when the customer
     selects the "Custom stain colour" finish option.
     Setting disabled=true when hidden prevents the empty field from being
     submitted to the cart as a line-item property. */
  function updateStainColourField(v) {
    var field = document.getElementById('CCStainColourField');
    var input = document.getElementById('CCStainColour');
    if (!field || !input) return;

    // Robust across products: any finish option that is a CUSTOM STAIN
    // (e.g. "Custom stain colour", "Custom Stain") reveals the colour field.
    // A plain "Stain" / "Clear Sealer" / "Natural" finish does not.
    var optStr = (v.options || []).join(' ').toLowerCase();
    var isCustomStain = optStr.indexOf('custom') !== -1 && optStr.indexOf('stain') !== -1;

    if (isCustomStain) {
      field.style.display = '';
      field.setAttribute('aria-hidden', 'false');
      input.disabled = false;
      input.required = true;
      input.setAttribute('aria-required', 'true');
    } else {
      field.style.display = 'none';
      field.setAttribute('aria-hidden', 'true');
      input.disabled = true;
      input.required = false;
      input.removeAttribute('aria-required');
      input.value = '';
    }
  }

  function updateVariant() {
    var v = findVariant();
    if (!v || !variantIdSel) return;

    /* Sync hidden variant ID select */
    variantIdSel.value = String(v.id);

    /* Update add-to-cart button */
    if (addBtn) {
      if (v.available) {
        addBtn.disabled     = false;
        addBtn.textContent  = 'Add to cart';
      } else {
        addBtn.disabled     = true;
        addBtn.textContent  = 'Sold out';
      }
    }

    /* Update price display */
    updatePriceDisplay(v);

    /* Keep the mobile sticky Add-to-Cart bar in sync (price + availability) */
    var stickyPriceEl = document.getElementById('StickyATCPrice');
    var stickyBtn = document.getElementById('StickyATCBtn');
    if (stickyPriceEl) {
      var sCompare = v.compare_at_price || 0;
      stickyPriceEl.innerHTML = (sCompare > v.price)
        ? '<s>' + money(sCompare) + '</s> <strong>' + money(v.price) + '</strong>'
        : '<strong>' + money(v.price) + '</strong>';
    }
    if (stickyBtn) {
      stickyBtn.disabled = !v.available;
      stickyBtn.textContent = v.available ? 'Add to cart' : 'Sold out';
    }

    /* Show / hide stain colour input */
    updateStainColourField(v);

    /* Reflect variant in URL without full reload */
    try {
      var url = new URL(window.location.href);
      url.searchParams.set('variant', v.id);
      window.history.replaceState({}, '', url.toString());
    } catch (e) {}
  }

  optionSelects.forEach(function (sel) {
    sel.addEventListener('change', updateVariant);
  });

  /* Initialise with the currently selected variant */
  updateVariant();
});
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true }
  ]
}
{% endschema %}
